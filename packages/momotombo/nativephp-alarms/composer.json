{
    "name": "momotombo/nativephp-alarms",
    "description": "Android native alarm contract for NativePHP Mobile.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Momotombo Devs",
            "email": "hello@momotombo.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^4.0"
    },
    "autoload": {
        "psr-4": {
        "Momotombo\\NativePHPAlarms\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Momotombo\\NativePHPAlarms\\AlarmServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
