{
    "name": "momotombo/nativephp-alarms",
    "description": "Exact, alarm-clock-grade alarms for NativePHP Mobile on Android: foreground playback, snooze, weekly repetition, boot restore, and an acknowledgement-based occurrence journal.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "keywords": [
        "nativephp",
        "nativephp-plugin",
        "nativephp-mobile",
        "laravel",
        "android",
        "alarm",
        "alarm-clock",
        "alarmmanager",
        "notifications"
    ],
    "homepage": "https://github.com/momotombodevs/nativephp-alarms",
    "support": {
        "issues": "https://github.com/momotombodevs/nativephp-alarms/issues",
        "source": "https://github.com/momotombodevs/nativephp-alarms"
    },
    "authors": [
        {
            "name": "Momotombo Devs",
            "email": "hello@momotombo.dev",
            "homepage": "https://momotombo.dev"
        }
    ],
    "require": {
        "php": "^8.3",
        "nativephp/mobile": "^4.6.1"
    },
    "require-dev": {
        "laravel/framework": "^11.0|^12.0|^13.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Momotombo\\NativePHPAlarms\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Momotombo\\NativePHPAlarms\\AlarmServiceProvider"
            ],
            "aliases": {
                "Alarm": "Momotombo\\NativePHPAlarms\\Facades\\Alarm"
            }
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
