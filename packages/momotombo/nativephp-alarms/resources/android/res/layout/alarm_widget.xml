<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/alarm_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/alarm_widget_icon_background"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_stat_alarm"
            android:tint="@color/alarm_widget_accent" />

        <TextView
            android:id="@+id/alarm_widget_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:text="Próxima alarma"
            android:textColor="@color/alarm_widget_accent"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/alarm_widget_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:includeFontPadding="false"
        android:text="7:00"
        android:textColor="@color/alarm_widget_foreground"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarm_widget_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="Despertá"
        android:textColor="@color/alarm_widget_supporting"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/alarm_widget_action"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/alarm_widget_action_background"
        android:contentDescription="Activar o pausar la próxima alarma"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="Activar o pausar"
        android:textColor="@color/alarm_widget_action_foreground"
        android:textSize="14sp" />
</LinearLayout>
